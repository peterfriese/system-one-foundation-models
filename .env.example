# =====================================================================
# System One Laya / MailTriageApp Environment Configuration Template
# Copy this file to .env and fill in your confidential API keys/tokens.
# NOTE: .env is gitignored and will never be committed to source control.
# =====================================================================

# TypeSafe Jev System One API Key (Required for Jev Cloud inference)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# System One Base URL (Defaults to https://api.typesafe.ai/v1/systemone)
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone

# Hosted VPC Bearer Token (Required for private enterprise hosted VPC backends)
HOSTED_VPC_TOKEN=your_hosted_vpc_token_here

# Hugging Face User Access Token (Required only for gated or private Core ML models)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Cloudflare Workers AI (Required for Clef & Clef-Flash cloud inference)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

